{
  "name": "fernly-clone",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node scripts/emulator-runner.mjs test",
    "test:e2e": "playwright test",
    "dev:api": "node --watch --env-file=server/.env server/index.js",
    "start:api": "node server/index.js",
    "dev:all": "node scripts/dev.mjs",
    "firebase:emulators": "node scripts/emulator-runner.mjs start",
    "firebase:deploy": "firebase deploy --only firestore:rules,firestore:indexes,storage",
    "firebase:import": "node --env-file=server/.env server/import-export.js",
    "admin:bootstrap": "node --env-file=server/.env server/bootstrap-admin.js",
    "test:e2e:accounts": "node scripts/emulator-runner.mjs accounts",
    "dev:regression": "vite --mode regression",
    "deployment:configure": "node scripts/deployment-config.mjs",
    "deployment:smoke": "node scripts/smoke.mjs",
    "db:verify": "node --env-file-if-exists=server/.env server/verify.js",
    "smtp:verify": "node --env-file-if-exists=server/.env server/smtp.js",
    "smtp:test": "node --env-file-if-exists=server/.env server/smtp.js --send-test",
    "db:restore-check": "node server/restore-check.js",
    "deploy:preflight": "node --env-file-if-exists=server/.env --env-file-if-exists=.env scripts/deployment-preflight.mjs",
    "deploy:check-api": "node scripts/check-api.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@js-temporal/polyfill": "^0.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "nodemailer": "^10.0.15",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-tools": "^15.32.1",
    "oxlint": "^1.81.0",
    "supertest": "^7.3.1",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22.20.0 <23"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5",
    "@opentelemetry/core": "2.12.0",
    "basic-ftp": "6.2.2",
    "re2": "1.27.0",
    "uuid": "11.1.1"
  },
  "allowScripts": {
    "@firebase/util": false,
    "protobufjs": false,
    "re2": false
  }
}
