NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:5173
COOKIE_SAME_SITE=lax
TRUST_PROXY=0
FIREBASE_PROJECT_ID=demo-dayora
FIREBASE_WEB_API_KEY=emulator-public-key
FIREBASE_STORAGE_BUCKET=demo-dayora.appspot.com
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
RATE_LIMIT_STORE=memory
MAIL_MODE=preview
MAIL_FROM=Dayora <hello@example.com>
# Preview links are written to ignored server/.mail-preview (development only).
# Production: REMOVE every emulator variable; use your real project/API key. Storage is optional.
# Inject FIREBASE_SERVICE_ACCOUNT_JSON through the host secret manager (one JSON string).
# Never copy its private_key into a VITE_* variable or commit credentials.
# Google-hosted ADC runtimes may use their attached service identity instead.
# NODE_ENV=production
# APP_ORIGIN=https://dayora-five.vercel.app
# COOKIE_SAME_SITE=none (direct Vercel-to-Render; Secure is automatic in production)
# FIREBASE_STORAGE_BUCKET=<optional exact bucket, only after Storage is enabled>
# TRUST_PROXY=1 (only behind the configured Render proxy)
# RATE_LIMIT_STORE=firestore

# Resend SMTP: replace the API-key placeholder in backend-only environment.
# MAIL_MODE=smtp
# MAIL_FROM=Dayora <onboarding@resend.dev>
# SMTP_URL=smtps://resend:YOUR_RESEND_API_KEY@smtp.resend.com:465
# Resend uses implicit TLS on port 465, username resend, API key as password.
# onboarding@resend.dev sends only to your Resend account email.
# For other users, verify your own domain and set MAIL_FROM to a sender on it.
# Percent-encode the API key if it contains URL-special characters.
# SMTP_URL query options are refused; certificate verification cannot be disabled.
# Optional one-time npm run smtp:test ONLY (do not leave enabled):
# SMTP_TEST_TO=<your-test-inbox>
# SMTP_TEST_CONFIRM=SEND_TEST_EMAIL
